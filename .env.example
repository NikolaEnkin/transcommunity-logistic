# Copy to .env, then npm run dev:local-env to load it.
# Default: local files only; no email is sent.
MAIL_MODE=local
# ENQUIRY_DIR=/absolute/private/path
# Configure only when email sending is explicitly wanted.
# MAIL_MODE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=website@example.com

# Render production (set in Render dashboard, not a committed .env):
# RENDER_EXTERNAL_URL is supplied by Render. For a custom domain:
# APP_ORIGIN=https://www.transcommunitylogistic.com
# SITE_ORIGIN=https://www.transcommunitylogistic.com
# ADDITIONAL_ORIGINS=https://transcommunitylogistic.com
# MAIL_MODE=disabled
# SEARCH_INDEXING=false
# Enable inbox or smtp only with a paid persistent disk mounted at /var/data:
# MAIL_MODE=inbox
# PERSISTENT_STORAGE=true
# ENQUIRY_DIR=/var/data/enquiries
